SECRET_KEY=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Email notification sent on every submitted waste report
REPORT_NOTIFY_EMAIL=admin@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM=your-gmail-address@gmail.com

# SmartWaste AI chatbot - leave GEMINI_API_KEY empty to run the assistant
# in deterministic fallback mode (no external calls, everything still works)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AI_CHAT_ENABLED=true
